{
  "name": "vizcoo",
  "version": "0.1.0",
  "description": "Live architecture visualization for TypeScript projects.",
  "type": "module",
  "bin": {
    "vizcoo": "./dist/bin/vizcoo.js"
  },
  "scripts": {
    "postinstall": "tsx scripts/fix-node-pty-perms.ts || true",
    "dev": "tsx bin/vizcoo.ts",
    "build": "tsc && vite build",
    "build:ui": "vite build",
    "build:server": "tsc",
    "typecheck": "tsc --noEmit",
    "verify": "tsx scripts/verify.ts",
    "test:view": "tsx scripts/test-view-highlight.ts",
    "test:hover": "tsx scripts/test-view-hover.ts",
    "test:live": "tsx scripts/test-live-hook.ts",
    "test:hooks": "tsx scripts/test-hooks-install.ts",
    "test:view-live": "tsx scripts/test-view-live.ts",
    "test:sessions": "tsx scripts/test-session-tracking.ts",
    "test:settings": "tsx scripts/test-settings.ts",
    "test:turns": "tsx scripts/test-turn-select.ts",
    "test:timeline": "tsx scripts/test-timeline.ts",
    "test:map-nav": "tsx scripts/test-map-nav.ts"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.10",
    "puppeteer": "^24.42.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.21"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@tree-sitter-grammars/tree-sitter-lua": "^0.4.1",
    "@types/d3-hierarchy": "^3.1.7",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^11.10.0",
    "chokidar": "^4.0.3",
    "d3-hierarchy": "^3.1.2",
    "ignore": "^5.3.2",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tree-sitter": "^0.21.1",
    "tree-sitter-c": "^0.23.6",
    "tree-sitter-go": "^0.23.4",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-kotlin": "^0.3.8",
    "tree-sitter-python": "^0.23.6",
    "tree-sitter-ruby": "^0.23.1",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-scala": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.24.7",
    "ws": "^8.20.0",
    "zustand": "^4.5.7"
  }
}
